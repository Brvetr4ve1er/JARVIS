{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/you/projects"],
      "permission": "ask"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "" },
      "permission": "ask"
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "permission": "allow"
    },
    "remote-example": {
      "url": "https://example.com/mcp/sse",
      "permission": "ask"
    }
  }
}
