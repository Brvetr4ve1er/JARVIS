# Where persistent memory (SQLite) lives. Defaults to ~/.jarvis if unset.
JARVIS_DATA_DIR=

# --- Local model runtime (llama.cpp `llama-server` or vLLM, both speak the OpenAI HTTP API) ---
# llama.cpp server default: http://127.0.0.1:8080/v1
# vLLM default:             http://127.0.0.1:8000/v1
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# Some servers ignore this, some require it to match what they loaded. Set to whatever you launched.
LOCAL_LLM_MODEL=local-model
# Only needed if your server enforces an API key (llama.cpp --api-key / vLLM --api-key).
LOCAL_LLM_API_KEY=

# --- Cloud providers (optional, multimodel switching activates automatically once a key is set) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Which provider name ("local", "anthropic", "openai") to use when the user doesn't override with /model
DEFAULT_PROVIDER=local
